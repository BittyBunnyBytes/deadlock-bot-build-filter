<root>
	<styles>
		<include src="s2r://panorama/styles/citadel_base_styles.vcss" />
		<include src="s2r://panorama/styles/popups/popups_shared.vcss" />
		<include src="s2r://panorama/styles/popups/citadel_popup_build_tag_picker.vcss" />
		<include src="s2r://panorama/styles/bot_build_filter/bot_build_filter.vcss_c" />
	</styles>
	<scripts>
		<include src="s2r://panorama/scripts/bot_build_filter/bot_build_filter_picker.vjs_c" />
	</scripts>
	<!-- The game's tag picker (rebuilt from its compiled layout), plus Bot Build Filter's group first. -->
	<PopupBuildTagPicker class="PopupPanel Hidden" popupbackground="dim" oncancel="UIPopupButtonClicked()">
		<Panel class="CloseButton" onmouseover="PlaySoundEffect( UI.MainMenu.Hover )" onactivate="UIPopupButtonClicked(); PlaySoundEffect( UI.MainMenu.Activate );" />
		<Label class="Title" text="#Citadel_BuildTagPicker_Title" />
		<Panel class="TagContainer BbfTagGroup">
			<Label class="TagHeader" text="Ordered and annotated" />
			<Panel class="TagList" id="BbfTags" />
		</Panel>
		<Panel class="TagContainer">
			<Label class="TagHeader" text="#Citadel_BuildTagPicker_Standard" />
			<Panel class="TagList" id="StandardTags" />
		</Panel>
		<Panel class="TagContainer">
			<Label class="TagHeader" text="#Citadel_BuildTagPicker_Abilities" />
			<Panel class="TagList" id="AbilityTags" />
		</Panel>
		<Panel class="TagContainer BuildItems">
			<Label class="TagHeader" text="#Citadel_BuildTagPicker_BuildItems" />
			<Panel class="TagList" id="BuildItemTags" />
		</Panel>
		<Panel class="TagContainer AllItems">
			<Label class="TagHeader" text="#Citadel_BuildTagPicker_WeaponItems" />
			<Panel class="TagList" id="WeaponItemTags" />
		</Panel>
		<Panel class="TagContainer AllItems">
			<Label class="TagHeader" text="#Citadel_BuildTagPicker_VitalityItems" />
			<Panel class="TagList" id="VitalityItemTags" />
		</Panel>
		<Panel class="TagContainer AllItems">
			<Label class="TagHeader" text="#Citadel_BuildTagPicker_SpiritItems" />
			<Panel class="TagList" id="SpiritItemTags" />
		</Panel>
	</PopupBuildTagPicker>
</root>
